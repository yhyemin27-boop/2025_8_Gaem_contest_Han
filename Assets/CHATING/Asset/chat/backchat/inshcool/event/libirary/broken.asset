  GKFAJSL_chat: 
  dialogueLines:
  - "\uC800\uC8FC\uB97C \uD478\uB294 \uBC29\uBC95\uC740 \uB450\uAC00\uC9C0\uC774\uB2E4."
  - "\uB2E4\uB978 \uC0AC\uB78C\uC744 \uB04C\uC5B4\uB4E4\uC5EC \uC790\uC2E0\uC774
    \uADF8 \uC0AC\uB78C\uC758 \uBAB8\uC73C\uB85C \uC0B4\uC544\uAC00\uB294 \uAC83\uC774
    \uCCAB\uBC88\uC9F8\uC774\uBA70,"
  - "\uC774 \uACBD\uC6B0 \uADF8 \uC0AC\uB78C\uC740 \uB098\uB97C \uB300\uC2E0\uD558\uC5EC
    \uADF8\uACF3\uC5D0 \uBA38\uBB3C\uAC8C \uB41C\uB2E4."
  - "\uB2E4\uB978 \uBC29\uBC95\uC73C\uB85C\uB294 \uC800\uC8FC\uB97C \uAC74 \uB2F9\uC0AC\uC790\uC758
    \uC601\uD63C\uC744 \uC62C\uBC14\uB978 \uBC29\uBC95\uC73C\uB85C \uC18C\uBA78\uC2DC\uD0A4\uB294
    \uAC83\uC774\uB2E4"
  - "\uC774 \uACBD\uC6B0 \uC800\uC8FC\uB97C \uAC74 \uC0AC\uB78C\uB9CC \uC8FD\uACE0,
    \uADF8 \uC774\uC678\uC758 \uC0AC\uB78C\uC740 \uB2E4\uC2DC \uB3CC\uC544\uAC04\uB2E4"
  - "\uCCAB\uBC88\uC9F8 \uACBD\uC6B0 \uC5B5\uC9C0\uB85C \uBE7C\uC557\uC544\uB4E4\uB824
    \uD558\uBA74, \uACF5\uAC04 \uC790\uCCB4\uAC00 \uAE68\uC9C0\uAE30 \uB54C\uBB38\uC5D0
    \uC81C3\uC790\uB294 \uBE60\uC838\uB098\uC62C \uC218 \uC788\uB2E4."
  - "\uC774 \uACBD\uC6B0 \uC81C 3\uC790\uAC00 \uC6D0\uB798 \uC788\uB358 \uACF3\uC73C\uB85C
    \uAC00\uBA70, \uAE30\uC5B5\uD558\uC9C0 \uBABB\uD55C\uB2E4 "
  hasChoice: 1
  choices:
  - text: "\uBA54\uBAA8\uD558\uC790"
