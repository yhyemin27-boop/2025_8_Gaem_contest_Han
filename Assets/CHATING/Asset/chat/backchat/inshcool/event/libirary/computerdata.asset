  GKFAJSL_chat: 
  dialogueLines:
  - "\u25CB\u25CB\uBE14\uB85C\uADF8\uAC00 \uCF1C\uC838 \uC788\uB2E4."
  - "\uC0AC\uB78C\uC744 \uC800\uC8FC\uD558\uB294 \uBC29\uBC95\uACFC \uC800\uC8FC\uB97C
    \uD478\uB294 \uBC29\uBC95\uC774 \uC801\uD600\uC788\uB2E4."
  - ...
  - "\uC0AC\uB78C\uC744 \uC800\uC8FC\uD558\uB294 \uB370\uC5D0\uB294 \uC800\uC8FC\uB2F9\uD558\uB294
    \uC0AC\uB78C\uACFC \uADF8\uC5D0 \uD574\uB2F9\uD558\uB294 \uAC00\uCE58\uAC00 \uD544\uC694\uD558\uB2E4."
  - "\uC800\uC8FC\uC5D0 \uC131\uACF5\uD560 \uACBD\uC6B0 \uC800\uC8FC\uB2F9\uD55C
    \uC0AC\uB78C\uC740 \uADF8 \uC2DC\uAC04\uB300\uC5D0 \uC601\uD63C\uC0C1\uD0DC\uB85C
    \uD63C\uC790 \uBA38\uBB3C\uAC8C \uB41C\uB2E4."
  - "\uD558\uC9C0\uB9CC, \uC774 \uACBD\uC6B0 \uC800\uC8FC\uB97C \uC790\uC2E0 \uB610\uD55C
    \uADF8 \uC2DC\uAC04\uB300\uC758 \uC8FC\uCD95\uC774 \uB418\uC5B4 \uBA38\uBB3C\uAC8C
    \uB41C\uB2E4."
  - "\uC800\uC8FC\uB97C \uB2F9\uD55C \uC0AC\uB78C\uACFC \uB2F9\uC0AC\uC790\uB294
    \uBAA8\uB450\uC758 \uAE30\uC5B5\uC18D\uC5D0\uC11C \uC78A\uC5B4\uC9C0\uAC8C \uB418\uC9C0\uB9CC,
    \uADF8\uC5D0 \uB300\uD55C \uC99D\uAC70\uB098 \uD588\uB358 \uC77C\uB4E4\uC740
    \uAE30\uC5B5\uD55C\uB2E4."
  hasChoice: 1
  choices:
  - text: "\uC800\uC8FC\uB97C \uD480\uAE30\uC704\uD55C \uC870\uAC74\uC744 \uBCF8\uB2E4"
