  GKFAJSL_chat: 
  dialogueLines:
  - 
  - "\uC568\uBC94\uC5D0\uB294 \uADF8 \uC0AC\uB78C\uC774 \uC788\uC5C8\uB2E4. \uADF8\uAC78
    \uBCF4\uB2C8 \uB0B4\uAC00 \uC9C0\uAE08\uAE4C\uC9C0 \uBCF8 \uBB3C\uD488\uB4E4\uC774
    \uC0DD\uAC01\uB0AC\uB2E4."
  - 
  - "\uD558\uC9C0\uB9CC, \uAD50\uBB34\uC2E4\uC5D0 \uAC00\uC11C \uB0B4\uBBFC \uC99D\uAC70\uB4E4\uC740
    \uBC18\uB824\uB2F9\uD588\uB2E4."
  - 
  - "\uBA87\uAC1C\uB294 \uD655\uC2E4\uD558\uC9C0\uB9CC, \uB2F9\uC0AC\uC790\uAC00
    \uC544\uB2C8\uAE30\uC5D0 \uD560 \uC218 \uC5C6\uB2E4\uACE0 \uD558\uC600\uB2E4."
  - 
  - "\uC77C\uB2E8 \uD55C\uBC88 \uBCF4\uACA0\uB2E4\uACE0 \uD588\uC9C0\uB9CC, \uD655\uB2F5\uC744
    \uC8FC\uC2E4 \uC218 \uC5C6\uB2E4\uACE0 \uD588\uB2E4."
  - 
  - "\uAD50\uBB34\uC2E4\uC5D0 \uB098\uC628 \uB098\uB294 \uD559\uC0DD\uB4E4\uC774
    \uC5C6\uB294 \uBCF5\uB3C4\uB97C \uBCF4\uBA74\uC11C \uC0DD\uAC01\uD588\uB2E4"
  - 
  - "\uC774\uC815\uB3C4\uC758 \uB178\uB825\uC744 \uD1B5\uD574\uC11C \uD55C\uC744
    \uD480 \uC218\uB294 \uC5C6\uACA0\uC9C0\uB9CC, "
  - 
  - "\uC801\uC5B4\uB3C4 \uADF8 \uC2DC\uAC04\uB300\uAC00 \uB418\uC5B4\uBC84\uB9B0
    \uC0AC\uB78C\uC5D0\uAC8C \uCD5C\uC18C\uD55C\uC758 \uB9C8\uC74C\uC744 \uB2F4\uC544\uC11C "
  - 
  - "\uC798 \uB418\uAE30\uB97C \uD76C\uB9DD\uD560 \uC218\uBC16\uC5D0 \uC5C6\uB2E4."
  hasChoice: 0
  choices: []
