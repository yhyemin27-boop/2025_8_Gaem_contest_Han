  GKFAJSL_chat: 
  dialogueLines:
  - "\uD3F0\uC73C\uB85C \uBCF4\uB2C8 \uC99D\uAC70\uB4E4\uC740 \uADF8\uB300\uB85C
    \uC788\uC5C8\uB2E4..."
  - 
  - "\uACE7 \uC878\uC5C5\uD560 \uC0AC\uB78C\uC774\uC9C0\uB9CC,"
  - 
  - "\uC774\uAC83\uB4E4\uC744 \uBB34\uC2DC\uD558\uC790\uB2C8,  \uC0AC\uB78C\uC758
    \uB9C8\uC74C\uC744 \uBB34\uC2DC\uD558\uB294\uAC70\uB77C\uACE0 \uC0DD\uAC01\uD588\uB2E4."
  - 
  - "......\uAD50\uBB34\uC2E4\uC5D0 \uAC00\uC11C \uC774\uAC83\uC5D0 \uB300\uD574
    \uB9D0\uD574\uBCF4\uB2C8,"
  - 
  - "\uC774\uAC78 \uC5B4\uB5BB\uAC8C \uC5BB\uC5C8\uB294\uC9C0\uC5D0 \uCE90\uBB3C\uC5C8\uB2E4."
  - 
  - "\uB098\uB294 \uADF8 \uB9D0\uC5D0\uB294 \uB2F5\uD574\uC904 \uC218 \uC5C6\uC5C8\uB2E4."
  - 
  - "\uC77C\uB2E8 \uC54C\uACA0\uB2E4\uACE0 \uD558\uC2DC\uBA70, \uC774\uAC74 \uC54C\uC544\uC11C
    \uD558\uC2DC\uACA0\uB2E4\uACE0 \uD558\uC168\uB2E4."
  - 
  - "\uBCF5\uB3C4\uC5D0\uC11C \uB3C4\uC11C\uAD00\uC5D0\uC11C \uBE4C\uB9B0 \uC568\uBC94\uC744
    \uBCF4\uB2C8, \uADF8 \uC0AC\uB78C\uC740 \uC788\uC5C8\uB2E4."
  - 
  - "\uADF8 \uC2DC\uAC04\uB300\uAC00 \uB418\uC5B4 \uBA38\uBB34\uB974\uAC8C \uB41C
    \uC0AC\uB78C\uC5D0\uAC8C \uCD5C\uC18C\uD55C\uC758 \uB9C8\uC74C\uC744 \uB2F4\uC544\uC11C "
  - 
  - "\uB354\uB294 \uBD88\uD589\uD55C \uC0AC\uB78C\uC774 \uC0DD\uAE30\uC9C0 \uC54A\uAE30\uB97C
    \uBE4C\uC5B4\uBCF8\uB2E4."
  hasChoice: 0
  choices: []
