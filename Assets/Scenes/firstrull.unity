  m_text: "\uC774 \uAC8C\uC784\uC740 \uC138\uC774\uBE0C\uAC00 \uC5C6\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\uC870\uC791\n\uBA54\uC778
